{
  "name": "deadgoat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker start deadgoat-pg || docker run -d --name deadgoat-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=deadgoat -p 54329:5432 postgis/postgis:16-3.4",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
